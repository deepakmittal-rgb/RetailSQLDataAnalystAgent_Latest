# ==============================================================================
# Retail SQL Data Analyst Agent - Environment Configuration
# ==============================================================================

# Database Dialect: "sqlite" (default local setup) or "mysql"
DB_TYPE="sqlite"
SQLITE_DB_PATH="retail.db"

# MySQL Connection Details (Required when DB_TYPE="mysql")
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD="your_mysql_password"
MYSQL_DATABASE="retail_db"

# Tiger Analytics AI Gateway / Gemini API Configuration
TIGER_GATEWAY_URL="https://api.tigeranalytics.com/gateway/v1"
TIGER_GATEWAY_API_KEY=""

# Gemini API Key (Injected automatically in AI Studio runtime)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Model Selection
DEFAULT_MODEL="gemini-3.8-flash"
TEMPERATURE=0.0

# Safety & Performance Caps
MAX_ROW_LIMIT=100
DEFAULT_ROW_LIMIT=25
QUERY_TIMEOUT_SECONDS=10

# Conversational Context Window Size (turns remembered)
MEMORY_WINDOW_SIZE=5
